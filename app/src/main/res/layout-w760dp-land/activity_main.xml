<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape main page: fixed no-scroll composition aimed at 832x468dp and
    960x540dp viewports (system bars included). The root is a plain FrameLayout
    so the page gets the exact available viewport (no ScrollView UNSPECIFIED
    remeasure/fillViewport growth); header and footer are compact rows and the
    workspace fills the remaining height. The log drawer overlays the workspace
    above the bottom action row so the Switch stays usable.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <LinearLayout
        android:id="@+id/page_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Compact header: SD icon + title/tagline inline, language on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sd_card"
                android:tint="@color/color_linux" />

            <LinearLayout
                android:id="@+id/header_text_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="@string/app_tagline"
                    android:textSize="11sp"
                    android:textColor="@color/color_muted" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icon_language"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_globe"
                android:tint="@color/color_muted" />

            <Spinner
                android:id="@+id/language_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minHeight="48dp"
                android:minWidth="96dp" />
        </LinearLayout>

        <!-- Workspace + log drawer overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/workspace_panels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Card panel -->
                <LinearLayout
                    android:id="@+id/card_panel"
                    style="@style/ArmadaPanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sd_card"
                            android:tint="@color/color_muted" />

                        <TextView
                            style="@style/ArmadaSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:includeFontPadding="false"
                            android:paddingStart="6dp"
                            android:paddingBottom="0dp"
                            android:text="@string/card_section" />
                    </LinearLayout>

                    <!-- Card summary: illustration beside spinner + capacity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">

                        <ImageView
                            android:id="@+id/icon_card_large"
                            android:layout_width="40dp"
                            android:layout_height="52dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sd_card_large" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="10dp">

                            <Spinner
                                android:id="@+id/card_spinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp" />

                            <TextView
                                android:id="@+id/text_capacity"
                                style="@style/ArmadaBody"
                                android:textSize="12sp"
                                android:includeFontPadding="false"
                                android:textColor="@color/color_muted"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:paddingTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Shizuku -->
                    <TextView
                        style="@style/ArmadaSectionTitle"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:text="@string/shizuku_section"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">

                        <View
                            android:id="@+id/shizuku_status_dot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_status_dot" />

                        <TextView
                            android:id="@+id/shizuku_state_text"
                            style="@style/ArmadaBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_muted"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:paddingStart="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">

                        <Button
                            android:id="@+id/button_authorize"
                            style="@style/ArmadaButtonSecondary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:text="@string/action_authorize" />

                        <Button
                            android:id="@+id/button_open_shizuku"
                            style="@style/ArmadaButtonSecondary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:textSize="13sp"
                            android:drawableStart="@drawable/ic_external_link"
                            android:drawablePadding="6dp"
                            android:text="@string/action_open_shizuku" />
                    </LinearLayout>

                    <!-- TF card operations -->
                    <TextView
                        style="@style/ArmadaSectionTitle"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:text="@string/card_ops_section"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />

                    <Button
                        android:id="@+id/button_refresh"
                        style="@style/ArmadaButtonSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:drawableStart="@drawable/ic_refresh"
                        android:drawablePadding="6dp"
                        android:text="@string/action_refresh" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="@string/refresh_hint"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:textColor="@color/color_muted" />
                </LinearLayout>

                <!-- Allocation panel -->
                <LinearLayout
                    android:id="@+id/allocation_panel"
                    style="@style/ArmadaPanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:layout_marginStart="10dp"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="2dp">

                        <TextView
                            style="@style/ArmadaSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:includeFontPadding="false"
                            android:paddingBottom="0dp"
                            android:text="@string/allocation_section" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:text="@string/allocation_intro"
                            android:textSize="11sp"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_muted"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Android / Linux stats side by side, centered under each system -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:paddingBottom="2dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/icon_android"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_android" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="6dp"
                                    android:text="@string/allocation_android"
                                    android:textSize="14sp"
                                    android:includeFontPadding="false"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_on_bg" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/caption_android"
                                android:textSize="10sp"
                                android:includeFontPadding="false"
                                android:textColor="@color/color_muted" />

                            <TextView
                                android:id="@+id/text_android_capacity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingTop="2dp"
                                android:text="@string/allocation_capacity_placeholder"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_android"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="22sp"
                                android:autoSizeMaxTextSize="32sp"
                                android:autoSizeStepGranularity="2sp"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/text_android_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="16sp"
                                android:includeFontPadding="false"
                                android:textStyle="bold"
                                android:textColor="@color/color_android" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:background="@color/color_outline" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/icon_linux"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_tux" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="6dp"
                                    android:text="@string/allocation_linux"
                                    android:textSize="14sp"
                                    android:includeFontPadding="false"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_on_bg" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/caption_linux"
                                android:textSize="10sp"
                                android:includeFontPadding="false"
                                android:textColor="@color/color_muted" />

                            <TextView
                                android:id="@+id/text_linux_capacity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingTop="2dp"
                                android:text="@string/allocation_capacity_placeholder"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_linux"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="22sp"
                                android:autoSizeMaxTextSize="32sp"
                                android:autoSizeStepGranularity="2sp"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/text_linux_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="16sp"
                                android:includeFontPadding="false"
                                android:textStyle="bold"
                                android:textColor="@color/color_linux" />
                        </LinearLayout>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_allocation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="8dp"
                        android:maxHeight="8dp"
                        android:max="100"
                        android:progress="50"
                        android:splitTrack="false"
                        android:progressDrawable="@drawable/bg_progress"
                        android:thumb="@drawable/progress_thumb"
                        android:progressTint="@null"
                        android:secondaryProgressTint="@null"
                        android:backgroundTint="@null"
                        android:thumbTint="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/allocation_android"
                            android:textSize="10sp"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_muted" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/allocation_linux"
                            android:textSize="10sp"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="2dp">

                        <ImageView
                            android:id="@+id/icon_warning"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_warning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="6dp"
                            android:text="@string/allocation_warning"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:textStyle="bold"
                            android:textColor="@color/color_warning" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="@string/allocation_linux_note"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:textColor="@color/color_muted" />

                    <!-- Status -->
                    <TextView
                        android:id="@+id/text_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:textColor="@color/color_accent" />

                    <!-- Handoff result (scrolls internally for long runtime status) -->
                    <LinearLayout
                        android:id="@+id/handoff_group"
                        style="@style/ArmadaCard"
                        android:padding="10dp"
                        android:layout_marginBottom="0dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/text_handoff_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_ok" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="88dp"
                            android:layout_marginTop="4dp"
                            android:scrollbarStyle="insideOverlay">

                            <TextView
                                android:id="@+id/text_handoff_message"
                                style="@style/ArmadaBody"
                                android:textSize="13sp"
                                android:paddingBottom="4dp" />
                        </ScrollView>

                        <Button
                            android:id="@+id/button_retry_handoff"
                            style="@style/ArmadaButtonSecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            android:text="@string/action_retry_handoff" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Action row anchored to the bottom of the panel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Switch
                            android:id="@+id/switch_show_logs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:drawableStart="@drawable/ic_log"
                            android:drawablePadding="8dp"
                            android:switchPadding="10dp"
                            android:text="@string/log_label"
                            android:textSize="15sp"
                            android:textColor="@color/color_on_bg" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/button_review"
                            style="@style/ArmadaButtonPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:drawableStart="@drawable/ic_log"
                            android:drawableEnd="@drawable/ic_arrow_forward"
                            android:drawablePadding="8dp"
                            android:text="@string/action_review" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Log drawer: overlays the workspace, sits above the action row so
                 the Switch stays reachable. Initially hidden. -->
            <LinearLayout
                android:id="@+id/log_drawer"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="56dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/bg_log_drawer"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_log"
                        android:tint="@color/color_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="@string/action_show_logs"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_bg" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/button_close_logs"
                        style="@style/ArmadaButtonSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="72dp"
                        android:textSize="13sp"
                        android:text="@string/action_close" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/log_panel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_log"
                    android:padding="8dp"
                    android:scrollbarStyle="insideOverlay">

                    <TextView
                        android:id="@+id/text_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:textColor="@color/color_on_bg"
                        android:textIsSelectable="true" />
                </ScrollView>

                <Button
                    android:id="@+id/button_copy_logs"
                    style="@style/ArmadaButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:text="@string/action_copy_logs" />
            </LinearLayout>
        </FrameLayout>

        <!-- Compact footer: version left, credits right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/color_muted" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_footer_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="13sp"
                android:textColor="@color/color_muted" />

            <TextView
                android:id="@+id/text_footer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:drawableEnd="@drawable/ic_external_link_small"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/color_muted"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/text_footer_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:textSize="13sp"
                android:textColor="@color/color_muted" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
