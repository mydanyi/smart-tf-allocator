<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/color_on_accent">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/color_primary_button_disabled" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:state_focused="true" android:state_enabled="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/color_primary_button" />
                    <corners android:radius="10dp" />
                    <stroke android:width="2dp" android:color="@color/color_on_bg" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/color_primary_button" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
