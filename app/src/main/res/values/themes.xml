<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Platform-only dark theme: no AppCompat / Material Components dependency.
        The window background, primary/secondary text and accent are set so the
        screen stays legible on a handheld and honours edge-to-edge insets.
    -->
    <style name="Theme.ArmadaTf" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/color_bg</item>
        <item name="android:colorBackground">@color/color_bg</item>
        <item name="android:colorForeground">@color/color_on_bg</item>
        <item name="android:textColorPrimary">@color/color_on_bg</item>
        <item name="android:textColorSecondary">@color/color_muted</item>
        <item name="android:textColorPrimaryInverse">@color/color_bg</item>
        <item name="android:colorAccent">@color/color_accent</item>
        <item name="android:colorControlNormal">@color/color_on_bg</item>
        <item name="android:colorControlActivated">@color/color_accent</item>
        <item name="android:colorControlHighlight">@color/color_accent_dim</item>
        <item name="android:textColorHint">@color/color_muted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ArmadaCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- Vertical workspace panel; width/weight are set inline by the host row. -->
    <style name="ArmadaPanel">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="ArmadaButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Primary action: teal filled, remains visibly outlined when focused, dims when disabled. -->
    <style name="ArmadaButtonPrimary" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <!-- Secondary action: graphite with quiet border, accent outline on focus. -->
    <style name="ArmadaButtonSecondary" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <style name="ArmadaSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_muted</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="ArmadaBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_on_bg</item>
    </style>
</resources>
