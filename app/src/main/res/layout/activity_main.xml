<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/color_bg"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: SD icon + title/tagline on the left, language spinner on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sd_card"
                android:tint="@color/color_linux" />

            <LinearLayout
                android:id="@+id/header_text_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:text="@string/app_tagline"
                    android:textSize="13sp"
                    android:textColor="@color/color_muted" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icon_language"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_globe"
                android:tint="@color/color_muted" />

            <Spinner
                android:id="@+id/language_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minHeight="48dp"
                android:minWidth="120dp" />
        </LinearLayout>

        <!-- Main two-column workspace: card 30% / allocation 70% -->
        <LinearLayout
            android:id="@+id/workspace_panels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingBottom="12dp">

            <!-- Card panel -->
            <LinearLayout
                android:id="@+id/card_panel"
                style="@style/ArmadaPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_card"
                        android:tint="@color/color_muted" />

                    <TextView
                        style="@style/ArmadaSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingBottom="0dp"
                        android:text="@string/card_section" />
                </LinearLayout>

                <!-- Card summary: large illustration beside spinner and capacity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/icon_card_large"
                        android:layout_width="44dp"
                        android:layout_height="56dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_card_large" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <Spinner
                            android:id="@+id/card_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp" />

                        <TextView
                            android:id="@+id/text_capacity"
                            style="@style/ArmadaBody"
                            android:textSize="13sp"
                            android:textColor="@color/color_muted"
                            android:paddingTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_outline"
                    android:layout_marginBottom="10dp" />

                <!-- Shizuku -->
                <TextView
                    style="@style/ArmadaSectionTitle"
                    android:text="@string/shizuku_section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <View
                        android:id="@+id/shizuku_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/shizuku_state_text"
                        style="@style/ArmadaBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:paddingStart="6dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_authorize"
                    style="@style/ArmadaButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/action_authorize" />

                <Button
                    android:id="@+id/button_open_shizuku"
                    style="@style/ArmadaButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:drawableStart="@drawable/ic_external_link"
                    android:drawablePadding="8dp"
                    android:text="@string/action_open_shizuku" />

                <Button
                    android:id="@+id/button_refresh"
                    style="@style/ArmadaButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="8dp"
                    android:text="@string/action_refresh" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="@string/refresh_hint"
                    android:textSize="11sp"
                    android:textColor="@color/color_muted" />
            </LinearLayout>

            <!-- Allocation panel -->
            <LinearLayout
                android:id="@+id/allocation_panel"
                style="@style/ArmadaPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:layout_marginStart="12dp">

                <TextView
                    style="@style/ArmadaSectionTitle"
                    android:text="@string/allocation_section" />

                <!-- Live inspection in progress/failed: no editor or review is
                     shown until the card's current layout is known. -->
                <TextView
                    android:id="@+id/text_inspection_state"
                    style="@style/ArmadaBody"
                    android:paddingTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/color_muted"
                    android:visibility="gone" />

                <!-- Completed allocation: replaces the whole editor below. -->
                <LinearLayout
                    android:id="@+id/allocation_summary_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_bg" />

                    <TextView
                        android:id="@+id/text_summary_total"
                        style="@style/ArmadaBody"
                        android:paddingTop="2dp"
                        android:textSize="13sp"
                        android:textColor="@color/color_muted" />

                    <TextView
                        android:id="@+id/text_summary_android"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_android" />

                    <TextView
                        android:id="@+id/text_summary_linux"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_linux" />

                    <TextView
                        android:id="@+id/text_summary_move_back"
                        style="@style/ArmadaBody"
                        android:paddingTop="10dp"
                        android:textSize="12sp"
                        android:textColor="@color/color_warning"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/button_manage_migration"
                        style="@style/ArmadaButtonSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawableStart="@drawable/ic_arrow_forward"
                        android:drawablePadding="8dp"
                        android:text="@string/summary_migration_entry" />

                    <Button
                        android:id="@+id/button_reallocate"
                        style="@style/ArmadaButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawableStart="@drawable/ic_refresh"
                        android:drawablePadding="8dp"
                        android:text="@string/action_reallocate" />
                </LinearLayout>

                <!-- Allocation editor: the original slider flow, shown only when
                     the card is not allocated or the user chose Reallocate. -->
                <LinearLayout
                    android:id="@+id/allocation_editor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="@string/allocation_intro"
                        android:textSize="11sp"
                        android:textColor="@color/color_muted" />

                    <!-- Android / Linux stats side by side, centered under each system -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/icon_android"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_android" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="6dp"
                                    android:text="@string/allocation_android"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_on_bg" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingTop="2dp"
                                android:text="@string/caption_android"
                                android:textSize="11sp"
                                android:textColor="@color/color_muted" />

                            <TextView
                                android:id="@+id/text_android_capacity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingTop="4dp"
                                android:text="@string/allocation_capacity_placeholder"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_android"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="22sp"
                                android:autoSizeMaxTextSize="36sp"
                                android:autoSizeStepGranularity="2sp"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/text_android_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_android" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/color_outline" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/icon_linux"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_tux" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="6dp"
                                    android:text="@string/allocation_linux"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_on_bg" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingTop="2dp"
                                android:text="@string/caption_linux"
                                android:textSize="11sp"
                                android:textColor="@color/color_muted" />

                            <TextView
                                android:id="@+id/text_linux_capacity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingTop="4dp"
                                android:text="@string/allocation_capacity_placeholder"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_linux"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="22sp"
                                android:autoSizeMaxTextSize="36sp"
                                android:autoSizeStepGranularity="2sp"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/text_linux_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_linux" />
                        </LinearLayout>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_allocation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="8dp"
                        android:maxHeight="8dp"
                        android:max="100"
                        android:progress="50"
                        android:splitTrack="false"
                        android:progressDrawable="@drawable/bg_progress"
                        android:thumb="@drawable/progress_thumb"
                        android:progressTint="@null"
                        android:secondaryProgressTint="@null"
                        android:backgroundTint="@null"
                        android:thumbTint="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/allocation_android"
                            android:textSize="11sp"
                            android:textColor="@color/color_muted" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/allocation_linux"
                            android:textSize="11sp"
                            android:textColor="@color/color_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="6dp">

                        <ImageView
                            android:id="@+id/icon_warning"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_warning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="6dp"
                            android:text="@string/allocation_warning"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_warning" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="@string/allocation_linux_note"
                        android:textSize="11sp"
                        android:textColor="@color/color_muted" />
                </LinearLayout>

                <!-- Status -->
                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:textSize="15sp"
                    android:textColor="@color/color_accent" />

                <!-- Handoff result -->
                <LinearLayout
                    android:id="@+id/handoff_group"
                    style="@style/ArmadaCard"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_handoff_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_ok" />

                    <TextView
                        android:id="@+id/text_handoff_message"
                        style="@style/ArmadaBody"
                        android:paddingTop="6dp"
                        android:paddingBottom="12dp" />

                    <Button
                        android:id="@+id/button_retry_handoff"
                        style="@style/ArmadaButtonSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/action_retry_handoff" />
                </LinearLayout>

                <!-- Action row: stacked at 360dp so the log switch, the editor
                     cancel and the review action never overflow horizontally.
                     Root stays scrollable in portrait. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp">

                    <Switch
                        android:id="@+id/switch_show_logs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:drawableStart="@drawable/ic_log"
                        android:drawablePadding="8dp"
                        android:switchPadding="10dp"
                        android:text="@string/log_label"
                        android:textSize="15sp"
                        android:textColor="@color/color_on_bg" />

                    <Button
                        android:id="@+id/button_cancel_reallocate"
                        style="@style/ArmadaButtonSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        android:text="@string/action_cancel_reallocate" />

                    <Button
                        android:id="@+id/button_review"
                        style="@style/ArmadaButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_log"
                        android:drawableEnd="@drawable/ic_arrow_forward"
                        android:drawablePadding="8dp"
                        android:text="@string/action_review" />
                </LinearLayout>

                <!-- Collapsible logs -->
                <ScrollView
                    android:id="@+id/log_panel"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_log"
                    android:padding="10dp"
                    android:visibility="gone"
                    android:scrollbarStyle="insideOverlay">

                    <TextView
                        android:id="@+id/text_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:textColor="@color/color_on_bg"
                        android:textIsSelectable="true" />
                </ScrollView>

                <Button
                    android:id="@+id/button_copy_logs"
                    style="@style/ArmadaButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:text="@string/action_copy_logs" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer: single compact row; credits/name/links/notice left, version right -->
        <LinearLayout
            android:id="@+id/footer_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="0dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_footer_prefix"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/color_muted" />

                    <TextView
                        android:id="@+id/text_footer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:focusable="false"
                        android:clickable="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_bg" />

                    <TextView
                        android:id="@+id/text_footer_bilibili"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:text="@string/footer_bilibili"
                        android:textSize="12sp"
                        android:textColor="@color/color_accent"
                        android:background="?android:attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/text_footer_github"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:text="@string/footer_github"
                        android:textSize="12sp"
                        android:textColor="@color/color_accent"
                        android:background="?android:attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/text_footer_suffix"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:layout_marginStart="8dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_bg" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:singleLine="true"
                android:layout_marginStart="12dp"
                android:textSize="12sp"
                android:textColor="@color/color_muted" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
