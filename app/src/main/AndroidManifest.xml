<?xml version="1.0" encoding="utf-8"?>
<!--
    The app is internal-only and installs to internal storage. Its single
    launcher Activity is the user entry point; the Shizuku provider stays the
    only other exported component and must remain exported and guarded by
    INTERACT_ACROSS_USERS_FULL, per the official Shizuku API setup:
    https://shizuku.rikka.app/guide/setup/

    The <queries> entry lets installed/not-running checks and the
    open-manager action resolve the Shizuku package under Android 11+
    package visibility.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!--
        QUERY_ALL_PACKAGES is required by the app's core app-migration feature:
        it must enumerate arbitrary user-installed packages, resolve their
        labels, and re-verify each app's current storage UUID via
        PackageManager after a service restart. A finite <queries> list cannot
        enumerate apps the user chooses at runtime, so the broad permission is
        kept and lint is suppressed for this single declaration only.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArmadaTf">

        <activity
            android:name="io.github.mydanyi.armadatf.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.mydanyi.armadatf.ui.MigrationActivity"
            android:exported="false"
            android:label="@string/migration_title"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density|locale" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
